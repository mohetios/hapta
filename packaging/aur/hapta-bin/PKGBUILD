# Maintainer: Ali Zemani <mehot1 at gmail dot com>
pkgname=hapta-bin
_pkgname=hapta
pkgver=2.2.0.r202610181721
pkgrel=1
pkgdesc="Minimalist weekly planner with Jalali (Persian) and other calendar systems and RTL support (prebuilt)"
arch=('x86_64')
url="https://github.com/mohetios/hapta"
license=('GPL-3.0-only')
depends=(
  'cairo'
  'dbus'
  'gcc-libs'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libayatana-appindicator' # tray icon, loaded at runtime
  'libsoup3'
  'webkit2gtk-4.1'
)
provides=("${_pkgname}")
conflicts=("${_pkgname}")
options=('!strip' '!debug')
# Always the newest release; CI uploads the deb under this stable name
source=("${_pkgname}_amd64.deb::${url}/releases/latest/download/${_pkgname}_amd64.deb")
sha256sums=('SKIP')

pkgver() {
  # app version from the deb + its build time (tar keeps mtimes), so every release upgrades
  local _ver
  _ver=$(bsdtar -xOf control.tar.gz ./control | sed -n 's/^Version: //p')
  mkdir -p stamp && bsdtar -xf data.tar.gz -C stamp ./usr/bin/hapta
  printf '%s.r%s' "${_ver}" "$(date -u -r stamp/usr/bin/hapta +%Y%m%d%H%M)"
}

package() {
  # Tauri's deb already uses the Arch layout: /usr/bin, .desktop, hicolor icons
  bsdtar -xf "${srcdir}/data.tar.gz" -C "${pkgdir}"
}
