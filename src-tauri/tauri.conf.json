{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hapta",
  "mainBinaryName": "hapta",
  "version": "../package.json",
  "identifier": "com.mohetios.hapta",
  "build": {
    "beforeDevCommand": "pnpm serve",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Minimalist weekly planner",
    "longDescription": "Minimalist weekly planner with Jalali (Persian) calendar and RTL support.",
    "publisher": "Ali Zemani",
    "homepage": "https://github.com/mohetios/hapta",
    "license": "GPL-3.0",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
